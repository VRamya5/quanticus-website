# =============================================================================
# Quanticus Environment Configuration Template
# Placeholders only. NEVER commit actual passwords or private keys to git.
# =============================================================================

# Node Environment ('production' on Render/Vercel, 'development' locally)
NODE_ENV=development
PORT=3000

# PostgreSQL Connection for Render (Single connection string with SSL enabled automatically)
# Render Dashboard -> PostgreSQL -> "Internal Database URL" (for backend service on Render)
DATABASE_URL=postgres://quanticus_user:secret_password@dpg-xxxxxx-a.oregon-postgres.render.com/quanticus_db

# Local PostgreSQL Fallback (Used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quanticus
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# First-time Admin Seed Credentials (setup.js creates account only if no admin exists)
ADMIN_EMAIL=admin@quanticustech.com
ADMIN_PASSWORD=your_strong_admin_password_here

# Session Secret (Cryptographically strong random string)
SESSION_SECRET=your_random_64_character_session_secret_string_here

# Proxy & Security Configuration
# Number of reverse proxies in front of Express (2 for Vercel -> Render)
TRUST_PROXY=2

# Comma-separated list of allowed origins for CSRF and state-changing API requests
# Example: https://quanticus.vercel.app,https://www.quanticus.com
ALLOWED_ORIGINS=https://YOUR-SITE.vercel.app
